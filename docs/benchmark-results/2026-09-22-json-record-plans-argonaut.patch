+// Preserve the ordinary PureScript implementation on JavaScript. The native
+// backend uses the same interface to select its shared construction plan.
+export const recordNilImpl = right => _object => _proxy => right({});
+export const recordConsImpl = _reflect => _step => _tail => fallback => _isRight => _rightValue => _right => fallback;
