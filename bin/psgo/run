#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/../.."

CLEAN=0
MODE="pure"
TEST_NAME=""

while [[ $# -gt 0 ]]
do
  case "$1" in
    -c|--clean)
    CLEAN=1
    shift
    ;;
    --test)
    if [ ! -f run/bak/psgo/spago.psgo.yaml ]; then
      mkdir -p run/bak/psgo
      cat <<EOF > run/bak/psgo/spago.psgo.yaml
package:
  name: ps-psgo-test
  dependencies:
    - console
    - effect
    - prelude
    - datetime
    - strings
    - arrays
    - partial
    - st
    - maybe
    - either
    - now
    - lazy
    - exceptions
    - foldable-traversable
    - refs
    - unsafe-coerce
    - functions
    - integers
    - enums
    - foreign-object
    - numbers
    - record
    - assert
    - aff
workspace:
  packageSet:
    registry: 77.7.0
EOF
    fi
    MODE="test"
    TEST_NAME="$2"
    shift 2
    ;;
    --x)
    MODE="x"
    shift
    ;;
    *)
    shift
    ;;
  esac
done

if ! command -v psgo &> /dev/null
then
    echo "Error: psgo could not be found."
    echo "purescript-native (psgo) is not installed."
    echo "It requires an x86 GHC to build, which is unsupported on Apple Silicon natively."
    exit 1
fi

if [ "$CLEAN" == "1" ]; then
  rm -rf run/bak/psgo/output/* run/bak/psgo/spago/* run/bak/psgo/output-go/*
fi
mkdir -p run/bak/psgo/output run/bak/psgo/spago run/bak/psgo/output-go
rm -rf output .spago spago.yaml spago.lock
ln -s run/bak/psgo/output output
ln -s run/bak/psgo/spago .spago
cp run/bak/psgo/spago.psgo.yaml spago.yaml
rm -f run/bak/psgo/spago.lock spago.lock

ENTRY_POINT="App"

if [ "$MODE" == "test" ]; then
  ENTRY_POINT="AppX"
  cat <<EOF > src/AppX.purs
module AppX where
import Prelude
import Effect (Effect)
import Bench (runBench)
import Test.$TEST_NAME as $TEST_NAME

main :: Effect Unit
main = void $ runBench $TEST_NAME.describe $TEST_NAME.act
EOF
  trap "rm -f src/AppX.purs" EXIT
fi

echo 'Building CoreFn for psgo...'
spago build

echo 'Generating Go via psgo...'
rm -f go.mod go.sum run/bak/psgo/go.mod run/bak/psgo/go.sum
rm -f run/bak/psgo/output/Main/Main.go
# Workaround: psgo sometimes crashes sporadically on the first run during generation.
# Calling it with a fallback ensures successful code generation.
(cd run/bak/psgo && (psgo --no-build || psgo --no-build || psgo --no-build))

echo "=== psgo Go ==="
if [ -d "output" ]; then
    (cd run/bak/psgo
    # Patch ffi_loader.go to use i-am-the-slime instead of purescript-native
    sed -i '' 's|github.com/purescript-native/go-ffi|github.com/i-am-the-slime/go-ffi|g' purescript-native/ffi_loader.go
    sed -i '' 's|github.com/purescript-native/go-ffi|github.com/i-am-the-slime/go-ffi|g' purescript-native/go.mod

    # Create FFI for Bench
    cat <<'EOF_FFI' > purescript-native/bench_ffi.go
package ffi_loader

import (
	"time"
	"fmt"
	. "github.com/purescript-native/go-runtime"
)

func init() {
	exports := Foreign("Bench")
	exports["benchNow"] = func() Any {
		return float64(time.Now().UnixNano()) / 1e3
	}
	exports["formatNumber"] = func(n Any) Any {
		return fmt.Sprintf("%.2f", n.(float64))
	}
	exports["opaque"] = func(a Any) Any {
		return func() Any { return a }
	}
}
EOF_FFI

    # Note: For development, we point to a local clone of i-am-the-slime/go-ffi if it exists.
    # If you are reproducing this benchmark and do not have go-ffi cloned locally,
    # the replace directive is skipped and 'go get' will fetch the remote repository automatically.
    go mod edit -dropreplace github.com/purescript-native/go-ffi
    if [ -d "../../../../go-ffi" ]; then
        go mod edit -replace github.com/i-am-the-slime/go-ffi=../../../../go-ffi
    fi

    # Run go get to satisfy the local modules that psgo replaces but doesn't require
    go get project.localhost/purescript-native/ffi-loader
    go get project.localhost/purescript-native/output
    go get github.com/purescript-native/go-runtime
    go get github.com/purescript-native/go-ffi
    go get github.com/i-am-the-slime/go-ffi

    # Use the requested ENTRY_POINT in Main.go
    sed -i '' "s|project.localhost/purescript-native/output/App|project.localhost/purescript-native/output/${ENTRY_POINT}|g" output/Main/Main.go
    sed -i '' "s|App.Ꞌmain|${ENTRY_POINT}.Ꞌmain|g" output/Main/Main.go

    # Build the Main package which is generated in the root
    go build -o Main ./output/Main/Main.go
    )
    
    if [ -f "run/bak/psgo/Main" ]; then
        
        GOGC=1000 ./run/bak/psgo/Main
    else
        echo "Failed to build Main"
    fi
else
    echo "No output generated by psgo."
fi
