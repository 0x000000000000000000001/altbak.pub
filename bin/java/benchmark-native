#!/usr/bin/env python3
"""Compare separate, validated Java native suites in fresh JVMs."""
import argparse
import json
from pathlib import Path
import statistics
import subprocess
import sys

ROOT=Path(__file__).resolve().parents[2]


def command(mode,action,directory):
    return [str(ROOT/'bin/java/run'),*([] if mode=='pure' else ['--'+mode]),
            action,'--build-dir',str(directory)]


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--runs',type=int,default=5)
    parser.add_argument('--include-pure',action='store_true')
    parser.add_argument('--build-root',type=Path,default=ROOT/'run/bak/java/modes')
    parser.add_argument('--output',type=Path,default=ROOT/'run/bak/java/native-bench')
    actions=parser.add_mutually_exclusive_group()
    actions.add_argument('--build-only',action='store_true')
    actions.add_argument('--run-only',action='store_true')
    args=parser.parse_args()
    args.build_root=args.build_root.resolve()
    if args.runs<3: parser.error('use at least three independent JVM runs')
    modes=['pure','ffi','fficc'] if args.include_pure else ['ffi','fficc']
    destination=args.output.resolve(); destination.mkdir(parents=True,exist_ok=True)
    if not args.run_only:
        for mode in modes:
            with (destination/f'{mode}-build.log').open('w') as output:
                subprocess.run(command(mode,'--build-only',args.build_root/mode),cwd=ROOT,
                               stdout=output,stderr=subprocess.STDOUT,check=True)
    if args.build_only:
        print('Java builds complete; no JVM benchmark was executed.'); return
    samples={mode:[] for mode in modes}
    manifests={}
    for block in range(args.runs):
        order=modes[block%len(modes):]+modes[:block%len(modes)]
        if (block//len(modes))%2: order=list(reversed(order))
        for mode in order:
            print(f'JVM block {block+1}/{args.runs}: {mode}',flush=True)
            log=destination/f'{block+1:02}-{mode}.log'
            with log.open('w') as output:
                subprocess.run(command(mode,'--run-only',args.build_root/mode),cwd=ROOT,
                               stdout=output,stderr=subprocess.STDOUT,check=True)
            # The runner validates exactly 14 results for this mode, plus labels and total.
            result=json.loads((args.build_root/mode/'results.json').read_text())
            samples[mode].append(result)
            manifests[mode]=json.loads((args.build_root/mode/'manifest.json').read_text())
            (destination/'checkpoint.json').write_text(json.dumps({'samples':samples,'manifests':manifests},indent=2)+'\n')
    summary={mode:{'median_each_case_us':[statistics.median(sample['times_us'][index] for sample in samples[mode]) for index in range(14)],
                   'median_total_ms':statistics.median(sample['total_ms'] for sample in samples[mode])}
             for mode in modes}
    report={'runs_per_mode':args.runs,'modes':modes,'process_order':'rotations with reversed blocks',
            'statistic':'median across fresh JVMs; each case reports its best of ten within that JVM',
            'whole_suite_warmups':3,'samples':samples,'summary':summary,'build_manifests':manifests}
    (destination/'results.json').write_text(json.dumps(report,indent=2)+'\n')
    print(f'All 14 values validated in each separate suite; report: {destination / "results.json"}')


if __name__=='__main__':
    try: main()
    except (OSError,ValueError,RuntimeError,subprocess.SubprocessError) as error:
        print(f'ERROR: {error}',file=sys.stderr); sys.exit(1)
