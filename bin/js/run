#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/../.."

mkdir -p run/bak/js/output run/bak/js/spago
rm -rf output .spago spago.yaml spago.lock
ln -s run/bak/js/output output
ln -s run/bak/js/spago .spago
ln -s run/bak/js/spago.js.yaml spago.yaml
touch run/bak/js/spago.lock && ln -s run/bak/js/spago.lock spago.lock
ENTRY_POINT="App"

if [ "$1" == "--test" ]; then
  ENTRY_POINT="AppX"
  TEST_NAME="$2"
  cat <<EOF > src/AppX.purs
module AppX where
import Prelude
import Effect (Effect)
import Bench (runBench)
import Test.$TEST_NAME as $TEST_NAME

main :: Effect Unit
main = runBench $TEST_NAME.describe $TEST_NAME.act
EOF
  trap "rm -f src/AppX.purs" EXIT
fi

npx spago build > /dev/null 2>&1

echo "=== Native Node V8 ==="
node -e "import('./output/${ENTRY_POINT}/index.js').then(m => m.main())"
