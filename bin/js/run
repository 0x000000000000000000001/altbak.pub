#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/../.."

mkdir -p run/bak/js/output run/bak/js/spago
rm -rf output .spago spago.yaml spago.lock
ln -s run/bak/js/output output
ln -s run/bak/js/spago .spago
ln -s run/bak/js/spago.js.yaml spago.yaml
touch run/bak/js/spago.lock && ln -s run/bak/js/spago.lock spago.lock
ENTRY_POINT="App"

if [ "$1" == "--test" ]; then
  ENTRY_POINT="AppX"
  TEST_NAME="$2"
  cat <<EOF > src/Bench.js
export const benchNow = () => performance.now() * 1000.0;
EOF
  cat <<EOF > src/Bench.purs
module Bench where
import Effect (Effect)
foreign import benchNow :: Effect Number
EOF
  cat <<EOF > src/AppX.purs
module AppX where
import Prelude
import Effect (Effect)
import Effect.Console (log)
import Bench (benchNow)
import Test.$TEST_NAME as $TEST_NAME

main :: Effect Unit
main = do
  $TEST_NAME.describe
  t1 <- benchNow
  $TEST_NAME.act
  t2 <- benchNow
  log ("\n[BENCHMARK] Execution time: " <> show (t2 - t1) <> " μs")
EOF
  trap "rm -f src/AppX.purs src/Bench.purs src/Bench.js" EXIT
fi

npx spago build > /dev/null 2>&1

echo "=== Native Node V8 ==="
time node -e "import('./output/${ENTRY_POINT}/index.js').then(m => m.main())"
