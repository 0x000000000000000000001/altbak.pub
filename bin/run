#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/.."
CLEAN=""
MODE="pure"
TEST_NAME=""

while [[ $# -gt 0 ]]
do
  case "$1" in
    --clean)
    CLEAN="--clean"
    shift
    ;;
    --test)
    MODE="test"
    TEST_NAME="$2"
    shift 2
    ;;
    --x)
    MODE="x"
    shift
    ;;
    *)
    shift
    ;;
  esac
done

if [ "$MODE" == "test" ]; then
  echo "================================"
  echo "  Running test $TEST_NAME...  "
  echo "================================"
  echo ""
  ./bin/js/run $CLEAN --test "$TEST_NAME" || echo "=== JS failed ==="
  
  echo ""
  ./bin/es/run $CLEAN --test "$TEST_NAME" || echo "=== ES failed ==="
  
  echo ""
  ./bin/php/run $CLEAN --test "$TEST_NAME" || echo "=== PHP failed ==="
  
  echo ""
  ./bin/go/run $CLEAN --test "$TEST_NAME" || echo "=== Go (gopurs) failed ==="
  
  echo ""
  ./bin/gnomon/run $CLEAN --test "$TEST_NAME" || echo "=== Go (Gnomon) failed ==="
  
  echo ""
  ./bin/sharp/run $CLEAN --test "$TEST_NAME" || echo "=== F#/C# failed ==="
  
  echo ""
  ./bin/scm/run $CLEAN --test "$TEST_NAME" || echo "=== Scheme failed ==="
  
  echo ""
  ./bin/erl/run $CLEAN --test "$TEST_NAME" || echo "=== Erlang failed ==="

elif [ "$MODE" == "x" ]; then
  echo "================================"
  echo "  Running extended backends...  "
  echo "================================"
  echo ""
  ./bin/js/run $CLEAN --x || echo "=== JS failed ==="
  
  echo ""
  ./bin/es/run $CLEAN --x || echo "=== ES failed ==="
  
  echo ""
  ./bin/php/run $CLEAN --x || echo "=== PHP failed ==="
  
  echo ""
  ./bin/go/run $CLEAN --x || echo "=== Go (gopurs) failed ==="
  
  echo ""
  ./bin/sharp/run $CLEAN --x || echo "=== F#/C# failed ==="
else
  echo "================================"
  echo "    Running pure backends...    "
  echo "================================"
  echo ""
  ./bin/js/run $CLEAN || echo "=== JS failed ==="
  
  echo ""
  ./bin/es/run $CLEAN || echo "=== ES failed ==="
  
  echo ""
  ./bin/scm/run $CLEAN || echo "=== Scheme failed ==="
  
  echo ""
  ./bin/erl/run $CLEAN || echo "=== Erlang failed ==="
  
  echo ""
  ./bin/php/run $CLEAN || echo "=== PHP failed ==="
  
  echo ""
  ./bin/go/run $CLEAN || echo "=== Go (gopurs) failed ==="
  
  echo ""
  ./bin/gnomon/run $CLEAN || echo "=== Go (Gnomon) failed ==="
  
  echo ""
  ./bin/sharp/run $CLEAN || echo "=== C# failed ==="
fi
