#!/usr/bin/env bash
set -uo pipefail
cd "$(dirname "$0")/.."

MODE=pure
WIP_INCLUDED=0
TEST=""
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --clean|-c) ARGS+=(--clean); shift ;;
    --build-only|--run-only) ARGS+=("$1"); shift ;;
    --ffi|--fficc|--x)
      [[ "$MODE" == pure && "$WIP_INCLUDED" == 0 ]] || { echo 'Choose only one benchmark mode.' >&2; exit 2; }
      MODE="${1#--}"; ARGS+=("$1"); shift ;;
    --wip-included)
      [[ "$MODE" == pure && "$WIP_INCLUDED" == 0 ]] || { echo '--wip-included requires the default core mode.' >&2; exit 2; }
      WIP_INCLUDED=1; shift ;;
    --test)
      [[ "$MODE" == pure && "$WIP_INCLUDED" == 0 && $# -ge 2 ]] || { echo '--test requires a module and cannot be combined with another mode.' >&2; exit 2; }
      MODE=test; TEST="${2#Test.}"; ARGS+=(--test "$2"); shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
done

# All documented core backends take part. Unsupported extended/foreign modes
# are excluded explicitly instead of being silently treated as compiled mode.
# --wip-included appends supported WIP cases after the core suite;
# the historical core total still covers only its fourteen cases.
BACKENDS=(js es php go rust sharp)
case "$MODE" in
  pure|test) BACKENDS+=(java wasm scm erl cpp psgo) ;;
  ffi|fficc) BACKENDS+=(java scm erl cpp) ;;
  x) ;;
esac
if [[ "$MODE" == test && ( "$TEST" == ArrayIndexing || "$TEST" == JsonTypedAst || "$TEST" == JsonDecoding ) ]]; then
  BACKENDS=(go js)
fi
FAILED=()
for backend in "${BACKENDS[@]}"; do
  echo "=== $backend / $MODE ==="
  EXTRA_ARGS=()
  if [[ "$WIP_INCLUDED" == 1 ]]; then
    case "$backend" in
      js|es|go|rust) EXTRA_ARGS=(--wip-included) ;;
      *) echo "WIP cases are not configured for $backend; running the core suite only." ;;
    esac
  fi
  if ! "./bin/$backend/run" ${ARGS[@]+"${ARGS[@]}"} ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}; then
    FAILED+=("$backend")
    echo "=== $backend failed ===" >&2
  fi
done
if [[ ${#FAILED[@]} -gt 0 ]]; then
  echo "Benchmark failures: ${FAILED[*]}" >&2
  exit 1
fi
