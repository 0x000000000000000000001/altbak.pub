#!/usr/bin/env bash
set -uo pipefail
cd "$(dirname "$0")/.."

MODE=pure
TEST=""
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --clean|-c) ARGS+=(--clean); shift ;;
    --build-only|--run-only) ARGS+=("$1"); shift ;;
    --ffi|--fficc|--x)
      [[ "$MODE" == pure ]] || { echo 'Choose only one benchmark mode.' >&2; exit 2; }
      MODE="${1#--}"; ARGS+=("$1"); shift ;;
    --test)
      [[ "$MODE" == pure && $# -ge 2 ]] || { echo '--test requires a module and cannot be combined with another mode.' >&2; exit 2; }
      MODE=test; TEST="${2#Test.}"; ARGS+=(--test "$2"); shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
done

# All documented core backends take part. Unsupported extended/foreign modes
# are excluded explicitly instead of being silently treated as compiled mode.
BACKENDS=(js es php go rust sharp)
case "$MODE" in
  pure|test) BACKENDS+=(java wasm scm erl cpp psgo) ;;
  ffi|fficc) BACKENDS+=(java scm erl cpp) ;;
  x) ;;
esac
if [[ "$MODE" == test && ( "$TEST" == ArrayIndexing || "$TEST" == JsonTypedAst ) ]]; then
  BACKENDS=(go js)
fi
FAILED=()
for backend in "${BACKENDS[@]}"; do
  echo "=== $backend / $MODE ==="
  if ! "./bin/$backend/run" ${ARGS[@]+"${ARGS[@]}"}; then
    FAILED+=("$backend")
    echo "=== $backend failed ===" >&2
  fi
done
if [[ ${#FAILED[@]} -gt 0 ]]; then
  echo "Benchmark failures: ${FAILED[*]}" >&2
  exit 1
fi
