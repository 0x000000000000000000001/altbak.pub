#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/../.."

CLEAN=0
MODE="pure"
TEST_NAME=""

while [[ $# -gt 0 ]]
do
  case "$1" in
    -c|--clean)
    CLEAN=1
    shift
    ;;
    --test)
    MODE="test"
    TEST_NAME="$2"
    shift 2
    ;;
    --x)
    MODE="x"
    shift
    ;;
    --ffi)
    MODE="ffi"
    shift
    ;;
    --fficc)
    MODE="fficc"
    shift
    ;;
    *)
    shift
    ;;
  esac
done

if [ "$CLEAN" == "1" ]; then
  rm -rf run/bak/sharp/output/* run/bak/sharp/spago/*
fi
mkdir -p run/bak/sharp/output run/bak/sharp/spago
rm -rf output .spago spago.yaml spago.lock
ln -s run/bak/sharp/output output
ln -s run/bak/sharp/spago .spago
ln -s run/bak/sharp/spago.sharp.yaml spago.yaml
touch run/bak/sharp/spago.lock && ln -s run/bak/sharp/spago.lock spago.lock

ENTRY_POINT="App"

if [ "$MODE" == "test" ]; then
  ENTRY_POINT="AppX"
  cat <<EOF > src/AppX.purs
module AppX where
import Prelude
import Effect (Effect)
import Bench (runBench)
import Test.$TEST_NAME as $TEST_NAME

main :: Effect Unit
main = void $ runBench $TEST_NAME.describe $TEST_NAME.act
EOF
  trap "rm -f src/AppX.purs" EXIT
elif [ "$MODE" == "x" ]; then
  ENTRY_POINT="AppX"
  cp -r srx/Test/* src/Test/
  cp srx/AppX.purs src/
  trap "rm -rf src/Test/STArray.purs src/Test/AffOperations.purs src/Test/StringOps.purs src/Test/FileOps src/AppX.purs" EXIT
elif [ "$MODE" == "ffi" ]; then
  ENTRY_POINT="AppFFI"
elif [ "$MODE" == "fficc" ]; then
  ENTRY_POINT="AppFFICheatcode"
fi

export PATH="$PWD/run/bak/js/node_modules/.bin:$HOME/.dotnet:$PATH"

if [ "$CLEAN" == "1" ]; then
  echo "=== Rebuilding sharpurs backend ==="
  (cd ../sharpurs/sharpurs && npm run build --silent)
fi

echo 'Building...'
spago build

# Generate C# code
node ../sharpurs/sharpurs/bin/sharpurs.js --main ${ENTRY_POINT} || exit 1

echo "=== F#/C# ==="
if [ -d "output/Main" ]; then
    cd output/Main
    dotnet run --project Program.fsproj -c Release
    cd ../..
else
    echo "No output/Main generated."
fi
