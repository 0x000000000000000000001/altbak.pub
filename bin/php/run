#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/../.."

CLEAN=0
MODE="pure"
TEST_NAME=""

while [[ $# -gt 0 ]]
do
  case "$1" in
    -c|--clean)
    CLEAN=1
    shift
    ;;
    --test)
    MODE="test"
    TEST_NAME="$2"
    shift 2
    ;;
    --x)
    MODE="x"
    shift
    ;;
    *)
    shift
    ;;
  esac
done

if [ "$CLEAN" == "1" ]; then
  rm -rf run/bak/php/output/* run/bak/php/spago/*
fi
mkdir -p run/bak/php/output run/bak/php/spago
rm -rf output .spago spago.yaml spago.lock
ln -s run/bak/php/output output
ln -s run/bak/php/spago .spago
ln -s run/bak/php/spago.php.yaml spago.yaml
touch run/bak/php/spago.lock && ln -s run/bak/php/spago.lock spago.lock

ENTRY_POINT="App"

if [ "$MODE" == "test" ]; then
  ENTRY_POINT="AppX"
  cat <<EOF > src/AppX.purs
module AppX where
import Prelude
import Effect (Effect)
import Bench (runBench)
import Test.$TEST_NAME as $TEST_NAME

main :: Effect Unit
main = void $ runBench $TEST_NAME.describe $TEST_NAME.act
EOF
  trap "rm -f src/AppX.purs" EXIT
elif [ "$MODE" == "x" ]; then
  ENTRY_POINT="AppX"
  # Temporarily inject extended tests
  cp -r srx/Test/* src/Test/
  cp srx/AppX.purs src/
  trap "rm -rf src/Test/STArray.purs src/Test/AffOperations.purs src/Test/StringOps.purs src/Test/FileOps src/Test/Parallelism.purs src/AppX.purs" EXIT
fi

export PATH="$PWD/run/bak/js/node_modules/.bin:$PATH"

if [ "$CLEAN" == "1" ]; then
  echo "=== Rebuilding phpurs backend ==="
  (cd ../phpurs && npm run build)
fi

echo 'Building...'
spago build --backend-args "--main ${ENTRY_POINT}" 

echo "=== PHP ==="
if [ -f "output/${ENTRY_POINT}/main.mod.php" ]; then
    php bin/php/composer.phar update --no-plugins -d run/bak/php
    mkdir -p /tmp/phpurs_opcache
    php -d xdebug.mode=off -d opcache.enable_cli=1 -d opcache.file_cache=/tmp/phpurs_opcache -d opcache.jit_buffer_size=128M -d opcache.jit=1255 output/${ENTRY_POINT}/main.mod.php
else
    echo "No output/${ENTRY_POINT}/main.mod.php generated."
fi
