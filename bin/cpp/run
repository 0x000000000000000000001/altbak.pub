#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/../.."

CLEAN=0
MODE="pure"
TEST_NAME=""

while [[ $# -gt 0 ]]
do
  case "$1" in
    -c|--clean)
    CLEAN=1
    shift
    ;;
    --test)
    if [ ! -f run/bak/cpp/spago.cpp.yaml ]; then
      mkdir -p run/bak/cpp
      cat <<EOF > run/bak/cpp/spago.cpp.yaml
package:
  name: ps-cpp-test
  dependencies:
    - console
    - effect
    - prelude
    - datetime
    - strings
    - arrays
    - partial
    - st
    - maybe
    - either
    - now
    - lazy
    - exceptions
    - foldable-traversable
    - refs
    - unsafe-coerce
    - functions
    - integers
    - enums
    - numbers
    - record
    - assert
    - aff
workspace:
  packageSet:
    registry: 77.7.0
EOF
    fi
    MODE="test"
    TEST_NAME="$2"
    shift 2
    ;;
    --x)
    MODE="x"
    shift
    ;;
    *)
    shift
    ;;
  esac
done

if ! command -v ../pscpp-bin/pscpp &> /dev/null
then
    echo "Error: pscpp could not be found in ../pscpp-bin/pscpp"
    exit 1
fi

if [ "$CLEAN" == "1" ]; then
  rm -rf run/bak/cpp/output/* run/bak/cpp/spago/* run/bak/cpp/ffi/*
fi
mkdir -p run/bak/cpp/output run/bak/cpp/spago run/bak/cpp/ffi
rm -rf output .spago spago.yaml spago.lock
ln -s run/bak/cpp/output output
ln -s run/bak/cpp/spago .spago
cp run/bak/cpp/spago.cpp.yaml spago.yaml
rm -f run/bak/cpp/spago.lock spago.lock

ENTRY_POINT="App"

if [ "$MODE" == "test" ]; then
  ENTRY_POINT="AppX"
  cat <<EOF > src/AppX.purs
module AppX where
import Prelude
import Effect (Effect)
import Bench (runBench)
import Test.$TEST_NAME as $TEST_NAME

main :: Effect Unit
main = void \$ runBench $TEST_NAME.describe $TEST_NAME.act
EOF
  trap "rm -f src/AppX.purs" EXIT
fi

echo 'Fetching dependencies via spago...'
spago fetch > /dev/null 2>&1

echo "Generating Main.purs for entry point $ENTRY_POINT..."
cat <<EOF > src/Main.purs
module Main where
import Prelude
import $ENTRY_POINT (main) as Entry
import Effect (Effect)

main :: Effect Unit
main = Entry.main
EOF

echo 'Building CoreFn for pscpp via pure 0.14.4 compiler (pscpp does not support TAST)...'
export PATH="/Users/0x1/Documents/htdocs/node_modules/.bin:$PATH"
purs compile -g corefn -o run/bak/cpp/output $(find .spago/p src test -name "*.purs" -type f 2>/dev/null) > /dev/null 2>&1

echo 'Generating C++ via pscpp...'
rm -f run/bak/cpp/Makefile
cd run/bak/cpp
find output/ -name "corefn.json" -exec ../../../../pscpp-bin/pscpp --makefile {} +

echo 'Patching purescript.h to fix operator!= bug...'
perl -0777 -pi -e 's/(class boxed \{\n\s*public:)/$1\n        auto operator==(const boxed& other) const -> bool { return shared.get() == other.shared.get(); }\n        auto operator!=(const boxed& other) const -> bool { return !(*this == other); }/g' output/src/purescript.h

echo 'Injecting C++ FFI bindings from purescript-native/cpp-ffi...'
if [ ! -d "/tmp/cpp-ffi" ]; then
    git clone https://github.com/purescript-native/cpp-ffi.git /tmp/cpp-ffi
fi
mkdir -p ffi
cp -R /tmp/cpp-ffi/* ffi/ 2>/dev/null || true

echo "Patching Data.Array FFI for PureScript 0.14+ compatibility..."
if [ -f ffi/arrays/data-array.cpp ]; then
    # Inject missing header for std::function
    sed -i.bak '1i\
#include <functional>\
' ffi/arrays/data-array.cpp

    # Inject uncurried rangeImpl and filterImpl right before FOREIGN_END
    sed -i.bak '/FOREIGN_END/i \
exports["rangeImpl"] = boxed(std::make_shared<std::function<boxed(const boxed\&, const boxed\&)>>([=](const boxed\& start_, const boxed\& end_) -> boxed { \
    const auto start = unbox<int>(start_); \
    const auto end = unbox<int>(end_); \
    const auto step = start > end ? -1 : 1; \
    array_t ns; \
    for (auto i = start; i != end; i += step) { \
        ns.emplace_back(i); \
    } \
    ns.emplace_back(end); \
    return ns; \
})); \
\
exports["filterImpl"] = boxed(std::make_shared<std::function<boxed(const boxed\&, const boxed\&)>>([=](const boxed\& f_, const boxed\& xs_) -> boxed { \
    const auto\& xs = unbox<array_t>(xs_); \
    array_t result; \
    for (const auto\& x : xs) { \
        if (unbox<bool>(f_(x))) { \
            result.emplace_back(x); \
        } \
    } \
    return result; \
})); \
' ffi/arrays/data-array.cpp
fi

echo "=== pscpp ==="
if [ -d "output" ]; then
    # Create FFI for Bench
    mkdir -p ffi/Bench
    cat <<'EOF_FFI' > ffi/Bench/bench_ffi.cc
#include "purescript.h"
#include <chrono>
#include <iostream>
#include <iomanip>
#include <sstream>

FOREIGN_BEGIN( Bench )

exports["benchNow"] = []() -> boxed {
    auto now = std::chrono::high_resolution_clock::now().time_since_epoch();
    double ms = std::chrono::duration_cast<std::chrono::nanoseconds>(now).count() / 1e6;
    return ms;
};

exports["formatNumber"] = [](const boxed& n) -> boxed {
    double val = unbox<double>(n);
    std::ostringstream ss;
    ss << std::fixed << std::setprecision(2) << val;
    return ss.str();
};

exports["opaque"] = [](const boxed& a) -> boxed {
    return [=]() -> boxed {
        return a;
    };
};

FOREIGN_END
EOF_FFI

    echo "C++ generation successful. Running first make pass to find missing FFI symbols..."
    make main > make.log 2>&1 || true
    
    echo "Generating FFI stubs for missing symbols..."
    python3 generate_stubs.py make.log output/src/stubs.cpp
    
    echo "Running final make pass..."
    if make main; then
        echo "Build successful! Executing..."
        ./output/bin/main
    else
        echo "Build failed!"
        exit 1
    fi
else
    echo "pscpp failed!"
    exit 1
fi
