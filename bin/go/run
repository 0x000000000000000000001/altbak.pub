#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/../.."

CLEAN=0
MODE="pure"
TEST_NAME=""

while [[ $# -gt 0 ]]
do
  case "$1" in
    --clean)
    CLEAN=1
    shift
    ;;
    --test)
    MODE="test"
    TEST_NAME="$2"
    shift 2
    ;;
    --x)
    MODE="x"
    shift
    ;;
    *)
    shift
    ;;
  esac
done

if [ "$CLEAN" == "1" ]; then
  rm -rf run/bak/go/output/* run/bak/go/spago/*
fi
mkdir -p run/bak/go/output run/bak/go/spago
rm -rf output .spago spago.yaml spago.lock
ln -s run/bak/go/output output
ln -s run/bak/go/spago .spago
ln -s run/bak/go/spago.go.yaml spago.yaml
touch run/bak/go/spago.lock && ln -s run/bak/go/spago.lock spago.lock

ENTRY_POINT="App"

if [ "$MODE" == "test" ]; then
  ENTRY_POINT="AppX"
  cat <<EOF > src/AppX.purs
module AppX where
import Prelude
import Effect (Effect)
import Bench (runBench)
import Test.$TEST_NAME as $TEST_NAME

main :: Effect Unit
main = void $ runBench $TEST_NAME.describe $TEST_NAME.act
EOF
  trap "rm -f src/AppX.purs" EXIT
elif [ "$MODE" == "x" ]; then
  ENTRY_POINT="AppX"
  cp -r srx/Test/* src/Test/
  cp srx/AppX.purs src/
  trap "rm -rf src/Test/STArray.purs src/Test/AffOperations.purs src/Test/StringOps.purs src/Test/FileOps src/AppX.purs" EXIT
fi

export PATH="$PWD/run/bak/js/node_modules/.bin:$PATH"

if [ "$CLEAN" == "1" ]; then
  echo "=== Rebuilding gopurs backend ==="
  (cd ../gopurs && npm run build --silent)
fi

spago build > /dev/null 2>&1 || echo "Compilation failed, but that's expected for now!"

# Generate Go code
node ../gopurs/bin/gopurs.js --main ${ENTRY_POINT}

echo "=== Native Go ==="
if [ -d "output/${ENTRY_POINT}" ]; then
    cd output
    rm -f go.mod
    go mod init gopurs/output > /dev/null 2>&1
    go mod tidy > /dev/null 2>&1
    # Inject pprof into output/main.go if requested
    if [ "$PPROF" == "1" ]; then
      cat << 'EOF' > patch_pprof.go
package main
import (
    "os"
    "log"
    "runtime/pprof"
)
func startPprof() func() {
    f, err := os.Create("cpu.prof")
    if err != nil {
        log.Fatal(err)
    }
    pprof.StartCPUProfile(f)
    return func() {
        pprof.StopCPUProfile()
        f.Close()
    }
}
EOF
      # Assume main.go has "func main() {"
      sed -i '' -e 's/func main() {/func main() { defer startPprof()() /' main.go
    fi
    
    go build -o go_app .
    cd ..
    
    ./output/go_app
else
    echo "No output/${ENTRY_POINT}/Main.go generated."
fi
