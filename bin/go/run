#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/../.."

CLEAN=0
MODE="pure"
TEST_NAME=""
USE_PGO=0

while [[ $# -gt 0 ]]
do
  case "$1" in
    -c|--clean)
    CLEAN=1
    shift
    ;;
    --pgo)
    USE_PGO=1
    shift
    ;;
    --test)
    MODE="test"
    TEST_NAME="$2"
    shift 2
    ;;
    --x)
    MODE="x"
    shift
    ;;
    --ffi)
    MODE="ffi"
    shift
    ;;
    --fficc)
    MODE="fficc"
    shift
    ;;
    *)
    shift
    ;;
  esac
done

if [ "$CLEAN" == "1" ]; then
  rm -rf run/bak/go/output/* run/bak/go/spago/*
fi
mkdir -p run/bak/go/output run/bak/go/spago
rm -rf output .spago spago.yaml spago.lock
ln -snf run/bak/go/output output
ln -snf run/bak/go/spago .spago
ln -snf run/bak/go/spago.go.yaml spago.yaml
touch run/bak/go/spago.lock && ln -snf run/bak/go/spago.lock spago.lock

ENTRY_POINT="App"

if [ "$MODE" == "test" ]; then
  ENTRY_POINT="AppX"
  cat <<EOF > src/AppX.purs
module AppX where
import Prelude
import Effect (Effect)
import Bench (runBench)
import Test.$TEST_NAME as $TEST_NAME

main :: Effect Unit
main = void $ runBench $TEST_NAME.describe $TEST_NAME.act
EOF
  trap "rm -f src/AppX.purs" EXIT
elif [ "$MODE" == "x" ]; then
  ENTRY_POINT="AppX"
  cp -r srx/Test/* src/Test/
  cp srx/AppX.purs src/
  trap "rm -rf src/Test/STArray.purs src/Test/AffOperations.purs src/Test/StringOps.purs src/Test/FileOps src/Test/Parallelism.purs src/AppX.purs" EXIT
elif [ "$MODE" == "ffi" ]; then
  ENTRY_POINT="AppFFI"
elif [ "$MODE" == "fficc" ]; then
  ENTRY_POINT="AppFFICheatcode"
fi

export PATH="$PWD/run/bak/js/node_modules/.bin:$PATH"

if [ "$CLEAN" == "1" ]; then
  echo "=== Rebuilding gopurs backend ==="
  (cd ../gopurs/gopurs && npm run build --silent)
fi

echo 'Building...'
spago build

# Generate Go code
NODE_OPTIONS="--max-old-space-size=8192" node ../gopurs/gopurs/bin/gopurs.js --main ${ENTRY_POINT} || echo "GOPURS FAILED" || exit 1

echo "=== Go ==="
if [ -d "output/main" ]; then
    cd output
    go mod tidy > /dev/null 2>&1
    
    if [ "$USE_PGO" == "1" ]; then
        echo "=== Profiling run (PGO) ==="
        PPROF=1 go build -o go_app ./main
        PPROF=1 GOGC=1000 ./go_app > /dev/null
        echo "=== Rebuilding with PGO ==="
        go build -pgo=cpu.prof -o go_app_pgo ./main
        cd ..
        GOGC=1000 ./output/go_app_pgo
    else
        go build -o go_app ./main
        cd ..

        # Warm up. After 2 seconds, run the benchmark.
        start_time=$(date +%s)
        for i in {1..50}; do
            GOGC=1000 ./output/go_app &>/dev/null
            if [ $(($(date +%s) - start_time)) -ge 2 ]; then
                break
            fi
        done
        
        GOGC=1000 ./output/go_app
    fi
else
    echo "No output/main/main.go generated."
fi
