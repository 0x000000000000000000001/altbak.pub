#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/../.."

CLEAN=0
MODE="pure"
TEST_NAME=""

while [[ $# -gt 0 ]]
do
  case "$1" in
    -c|--clean)
    CLEAN=1
    shift
    ;;
    --test)
    MODE="test"
    TEST_NAME="$2"
    shift 2
    ;;
    --x)
    MODE="x"
    shift
    ;;
    *)
    shift
    ;;
  esac
done

if [ "$CLEAN" == "1" ]; then
  rm -rf run/bak/es/output-purs/* run/bak/js/spago/*
fi
mkdir -p run/bak/es/output-purs run/bak/js/spago
rm -rf output .spago spago.yaml spago.lock
ln -s run/bak/es/output-purs output
ln -s run/bak/js/spago .spago
ln -s run/bak/js/spago.js.yaml spago.yaml
touch run/bak/es/spago.lock && ln -s run/bak/es/spago.lock spago.lock

ENTRY_POINT="App"

if [ "$MODE" == "test" ]; then
  ENTRY_POINT="AppX"
  cat <<EOF > src/AppX.purs
module AppX where
import Prelude
import Effect (Effect)
import Bench (runBench)
import Test.$TEST_NAME as $TEST_NAME

main :: Effect Unit
main = void $ runBench $TEST_NAME.describe $TEST_NAME.act
EOF
  trap "rm -f src/AppX.purs" EXIT
elif [ "$MODE" == "x" ]; then
  ENTRY_POINT="AppX"
  # Temporarily inject extended tests
  cp -r srx/Test/* src/Test/
  cp srx/AppX.purs src/
  trap "rm -rf src/Test/STArray.purs src/Test/AffOperations.purs src/Test/StringOps.purs src/Test/FileOps src/Test/Parallelism.purs src/AppX.purs" EXIT
fi

export PATH="$PWD/run/bak/js/node_modules/.bin:$PATH"
echo 'Building...'
spago build > /dev/null 2>&1
purs-backend-es build --output-dir run/bak/es/output > /dev/null 2>&1
find run/bak/es/output-purs -name "foreign.js" | while read -r f; do
  dest="run/bak/es/output/$(basename $(dirname $f))"
  mkdir -p "$dest"
  cp "$f" "$dest/foreign.js"
done

echo "=== Arista ES V8 ==="
        start_time=$(date +%s)
        for i in {1..50}; do
            node -e "import('./run/bak/es/output/' + '$ENTRY_POINT' + '/index.js').then(m => m.main())" &>/dev/null
            if [ $(($(date +%s) - start_time)) -ge 2 ]; then
                break
            fi
        done
        
node -e "import('./run/bak/es/output/' + '$ENTRY_POINT' + '/index.js').then(m => m.main())"
