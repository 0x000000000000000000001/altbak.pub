#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/../.."

CLEAN=0
MODE="pure"
TEST_NAME=""

while [[ $# -gt 0 ]]
do
  case "$1" in
    -c|--clean)
    CLEAN=1
    shift
    ;;
    --test)
    if [ ! -f run/bak/gnomon/spago.gnomon.yaml ]; then
      cat <<EOF > run/bak/gnomon/spago.gnomon.yaml
package:
  name: ps-gnomon-test
  dependencies:
    - console
    - effect
    - prelude
workspace:
  packageSet:
    registry: 77.7.0
  extraPackages:
    prelude:
      path: "../gopurs/gopurs-prelude"
    effect:
      path: "../gopurs/gopurs-effect"
    console:
      path: "../gopurs/gopurs-console"
    datetime:
      path: "../gopurs/gopurs-datetime"
    strings:
      path: "../gopurs/gopurs-strings"
    arrays:
      path: "../gopurs/gopurs-arrays"
    partial:
      path: "../gopurs/gopurs-partial"
    st:
      path: "../gopurs/gopurs-st"
    maybe:
      path: "../gopurs/gopurs-maybe"
    either:
      path: "../gopurs/gopurs-either"
    now:
      path: "../gopurs/gopurs-now"
    lazy:
      path: "../gopurs/gopurs-lazy"
    exceptions:
      path: "../gopurs/gopurs-exceptions"
    foldable-traversable:
      path: "../gopurs/gopurs-foldable-traversable"
    refs:
      path: "../gopurs/gopurs-refs"
    unsafe-coerce:
      path: "../gopurs/gopurs-unsafe-coerce"
    functions:
      path: "../gopurs/gopurs-functions"
    integers:
      path: "../gopurs/gopurs-integers"
    enums:
      path: "../gopurs/gopurs-enums"
    foreign-object:
      path: "../gopurs/gopurs-foreign-object"
    numbers:
      path: "../gopurs/gopurs-numbers"
    record:
      path: "../gopurs/gopurs-record"
    assert:
      path: "../gopurs/gopurs-assert"
EOF
    fi
    MODE="test"
    TEST_NAME="$2"
    shift 2
    ;;
    --x)
    MODE="x"
    shift
    ;;
    *)
    shift
    ;;
  esac
done

if [ "$CLEAN" == "1" ]; then
  rm -rf run/bak/gnomon/output/* run/bak/gnomon/spago/* run/bak/gnomon/output-go/*
fi
mkdir -p run/bak/gnomon/output run/bak/gnomon/spago run/bak/gnomon/output-go
rm -rf output .spago spago.yaml spago.lock
ln -s run/bak/gnomon/output output
ln -s run/bak/gnomon/spago .spago
cp run/bak/gnomon/spago.gnomon.yaml spago.yaml
touch run/bak/gnomon/spago.lock && ln -s run/bak/gnomon/spago.lock spago.lock

ENTRY_POINT="App"

if [ "$MODE" == "test" ]; then
  ENTRY_POINT="AppX"
  cat <<EOF > src/AppX.purs
module AppX where
import Prelude
import Effect (Effect)
import Bench (runBench)
import Test.$TEST_NAME as $TEST_NAME

main :: Effect Unit
main = void $ runBench $TEST_NAME.describe $TEST_NAME.act
EOF
  trap "rm -f src/AppX.purs" EXIT
elif [ "$MODE" == "x" ]; then
  # Gnomon does not support Aff, skip extended tests for now
  echo "Gnomon does not support Aff (required by extended tests). Skipping."
  exit 0
fi

# Clone Gnomon if missing
if [ ! -d "run/bak/gnomon/Gnomon" ]; then
  echo "Cloning Gnomon..."
  git clone https://github.com/afcondon/Gnomon.git run/bak/gnomon/Gnomon
  # Patch spago.yaml in Gnomon to find purescript-backend-optimizer
  sed -i '' 's|../../purescript-backend-optimizer|../../../../../../purescript-backend-optimizer|g' run/bak/gnomon/Gnomon/backend-go/spago.yaml
  sed -i '' 's|module PureScript.Backend.Optimizer.Reachability|module Gnomon.Reachability|g' run/bak/gnomon/Gnomon/backend-go/src/PureScript/Backend/Optimizer/Reachability.purs
  sed -i '' 's|import PureScript.Backend.Optimizer.Reachability|import Gnomon.Reachability|g' run/bak/gnomon/Gnomon/backend-go/src/Main.purs
  
  # Also patch Go.purs to ignore Typed nodes
  sed -i '' '/Op2 (OpNumberNum op)/a\
\  Typed _ a -> genNumeric k typed a\
' run/bak/gnomon/Gnomon/backend-go/src/PureScript/Backend/Optimizer/Codegen/Go.purs
  sed -i '' '/Op1 OpBooleanNot/a\
\  Typed _ a -> genBoolNumeric k typed a\
' run/bak/gnomon/Gnomon/backend-go/src/PureScript/Backend/Optimizer/Codegen/Go.purs
  sed -i '' '/brLine <> regLines) <> "\\ncontinue"/a\
\  Typed _ a -> genStmtsNumeric k ctx typed a\
' run/bak/gnomon/Gnomon/backend-go/src/PureScript/Backend/Optimizer/Codegen/Go.purs
  sed -i '' '/brLine <> regLines) <> "\\ncontinue"/a\
\  Typed _ a -> genStmts ctx a\
' run/bak/gnomon/Gnomon/backend-go/src/PureScript/Backend/Optimizer/Codegen/Go.purs
  sed -i '' '/Fail msg/a\
\  Typed _ a -> genExpr a\
' run/bak/gnomon/Gnomon/backend-go/src/PureScript/Backend/Optimizer/Codegen/Go.purs

  # Patch Builder.purs onSkipModule
  sed -i '' 's|onSkipModule: \\_ \\_ -> pure unit|onSkipModule: \\_ \\_ -> pure Nothing|g' run/bak/gnomon/Gnomon/backend-go/src/PureScript/Backend/Optimizer/Codegen/Go/Builder.purs
  sed -i '' 's|Data.Maybe (Maybe, maybe)|Data.Maybe (Maybe(..), maybe)|g' run/bak/gnomon/Gnomon/backend-go/src/PureScript/Backend/Optimizer/Codegen/Go/Builder.purs

  echo "Building Gnomon backend-go..."
  (cd run/bak/gnomon/Gnomon/backend-go && spago build)
fi

echo 'Building CoreFn for Gnomon...'
spago build

echo 'Generating Go via Gnomon...'
(cd run/bak/gnomon/Gnomon/backend-go && spago run -- --corefn-dir ../../output --output-dir ../../output-go --main ${ENTRY_POINT})

echo "=== Gnomon Go ==="
if [ -d "run/bak/gnomon/output-go" ]; then
    # Copy runtime.go to output dir
    cp run/bak/gnomon/Gnomon/backend-go/runtime.go run/bak/gnomon/output-go/
    
    # Generate FFI for Bench
    cat <<'EOF_FFI' > run/bak/gnomon/output-go/gnomon_ffi.go
package main

import (
	"time"
	"fmt"
)

var Bench_benchNow any = func() any {
	return float64(time.Now().UnixNano()) / 1e3
}

var Bench_formatNumber any = func(n any) any {
	return fmt.Sprintf("%.2f", n.(float64))
}

var Bench_opaque any = func(a any) any {
	return func() any { return a }
}
EOF_FFI

    cd run/bak/gnomon/output-go
    rm -f go.mod
    go mod init gnomon/output > /dev/null 2>&1
    go mod tidy > /dev/null 2>&1
    go build -o go_app ./
    cd ../../../..
    
    GOGC=1000 ./run/bak/gnomon/output-go/go_app
else
    echo "No output generated by Gnomon."
fi
