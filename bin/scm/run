#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/../.."

CLEAN=0
MODE="pure"
TEST_NAME=""

while [[ $# -gt 0 ]]
do
  case "$1" in
    -c|--clean)
    CLEAN=1
    shift
    ;;
    --test)
    MODE="test"
    TEST_NAME="$2"
    shift 2
    ;;
    --x)
    MODE="x"
    shift
    ;;
    --ffi)
    MODE="ffi"
    shift
    ;;
    --fficc)
    MODE="fficc"
    shift
    ;;
    *)
    shift
    ;;
  esac
done

if [ "$CLEAN" == "1" ]; then
  rm -rf run/bak/scm/output/* run/bak/scm/spago/*
fi
mkdir -p run/bak/scm/output run/bak/scm/spago
rm -rf output .spago spago.yaml spago.lock
ln -s run/bak/scm/output output
ln -s run/bak/scm/spago .spago
ln -s run/bak/scm/spago.scm.yaml spago.yaml
touch run/bak/scm/spago.lock && ln -s run/bak/scm/spago.lock spago.lock
export PATH="$PWD/bin/purs-vanilla/node_modules/.bin:$PWD/run/bak/js/node_modules/.bin:$PATH"
ENTRY_POINT="App"

if [ "$MODE" == "test" ]; then
  ENTRY_POINT="AppX"
  cat <<'INNEREOF' > src/AppX.purs
module AppX where
import Prelude
import Effect (Effect)
import Test.$TEST_NAME as $TEST_NAME

main :: Effect Unit
main = do
  $TEST_NAME.describe
  $TEST_NAME.act
INNEREOF
  trap "rm -f src/AppX.purs" EXIT
elif [ "$MODE" == "x" ]; then
  ENTRY_POINT="AppX"
  # Temporarily inject extended tests
  cp -r srx/Test/* src/Test/
  cp srx/AppX.purs src/
  trap "rm -rf src/Test/STArray.purs src/Test/AffOperations.purs src/Test/StringOps.purs src/Test/FileOps src/AppX.purs" EXIT
elif [ "$MODE" == "ffi" ]; then
  ENTRY_POINT="AppFFI"
elif [ "$MODE" == "fficc" ]; then
  ENTRY_POINT="AppFFICheatcode"
fi

echo 'Building...'
spago build >/dev/null
PATH="$(pwd)/bin/scm:$PATH" purescm build >/dev/null
mkdir -p run/bak/scm/output_bin
PATH="$(pwd)/bin/scm:$PATH" purescm bundle-app --main ${ENTRY_POINT} --output run/bak/scm/output_bin

echo "=== Scheme ==="
export DYLD_LIBRARY_PATH="/opt/homebrew/lib:/opt/homebrew/opt/icu4c/lib:/opt/homebrew/opt/pcre2/lib"

chez --optimize-level 3 --program run/bak/scm/output_bin/main
